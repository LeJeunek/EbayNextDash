# .env.local

# Database (PostgreSQL via Supabase, Railway, Neon, etc.)
DATABASE_URL="postgresql://user:password@host:5432/ebay_dashboard?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="YpX+iSadUY5bSU8bonU+swYBgWWEVMtZldOqFjAmx3s="

# eBay OAuth2 App Credentials
# Get these from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID="your-ebay-app-client-id"
EBAY_CLIENT_SECRET="your-ebay-app-client-secret"

# eBay API Environment: "sandbox" or "production"
EBAY_ENVIRONMENT="sandbox"

# eBay OAuth endpoints (auto-set based on environment above, but can override)
# Sandbox:    https://auth.sandbox.ebay.com/oauth2/authorize
# Production: https://auth.ebay.com/oauth2/authorize
EBAY_AUTH_URL="https://auth.sandbox.ebay.com/oauth2/authorize"
EBAY_TOKEN_URL="https://api.sandbox.ebay.com/identity/v1/oauth2/token"
EBAY_API_BASE="https://api.sandbox.ebay.com"
