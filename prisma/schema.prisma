// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer). This is what the app uses at runtime, and
  // what a serverless host like Vercel wants.
  url       = env("DATABASE_URL")
  // Direct connection, no pooler. Prisma uses this for `db push` and
  // migrations, which issue DDL that a transaction-mode pooler cannot run
  // reliably. `prisma generate` does not need it, so builds still succeed
  // when only DATABASE_URL is set.
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  ebayUserId    String?   @unique
  ebayUsername  String?
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  orders        Order[]
  inventory     InventoryItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id              String        @id @default(cuid())
  ebayListingId   String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?       @db.Text
  price           Float
  currency        String        @default("USD")
  quantity        Int           @default(1)
  quantitySold    Int           @default(0)
  status          ListingStatus @default(ACTIVE)
  category        String?
  imageUrl        String?
  listingUrl      String?
  startTime       DateTime?
  endTime         DateTime?
  condition       String?
  shippingCost    Float?
  ebayFee         Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]

  @@index([userId])
  @@index([status])
}

model Order {
  id              String      @id @default(cuid())
  orderId         String      @unique   // eBay order ID
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId       String?
  listing         Listing?    @relation(fields: [listingId], references: [id])
  buyerUsername   String?
  buyerEmail      String?
  itemTitle       String
  salePrice       Float
  shippingCost    Float       @default(0)
  ebayFee         Float       @default(0)
  profit          Float       @default(0)   // salePrice - shippingCost - ebayFee - itemCost
  currency        String      @default("USD")
  status          OrderStatus @default(PENDING)
  paymentStatus   String?
  shippingStatus  String?
  trackingNumber  String?
  carrier         String?
  saleDate        DateTime
  paidDate        DateTime?
  shippedDate     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([saleDate])
  @@index([orderId])
}

enum ListingStatus {
  ACTIVE
  ENDED
  SOLD
  DRAFT
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

/// Hand-managed inventory ledger: one row per item you bought to resell.
/// Independent of the eBay sync so rows can be added/edited by hand, but
/// optionally linked back to an eBay listing or order.
model InventoryItem {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  sku          String?
  category     String?
  condition    String?
  notes        String?         @db.Text

  // Where it came from
  purchaseDate DateTime?
  source       String?

  // Money in / money out. Profit is derived, never stored, so it can
  // never drift out of sync with the numbers it is computed from.
  originalCost Float           @default(0)
  sellPrice    Float?
  packingCost  Float           @default(0)
  shippingCost Float           @default(0)
  ebayFee      Float           @default(0)
  otherCost    Float           @default(0)

  status       InventoryStatus @default(LISTED)
  listedDate   DateTime?
  soldDate     DateTime?

  // Optional links back to synced eBay records
  ebayListingId String?
  ebayOrderId   String?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, soldDate])
}

enum InventoryStatus {
  DRAFT
  LISTED
  SOLD
  RETURNED
  UNSOLD
}
